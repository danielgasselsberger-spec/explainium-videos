 "segments": [
  {
   "t0": 0.0,
   "t1": 1.748,
   "scene": 1,
   "text": "In meiner Stadt kommen nachts die Schatten."
  },
  {
   "t0": 2.028,
   "t1": 2.918,
   "scene": 1,
   "text": "Und ich bin allein."
  },
  {
   "t0": 3.368,
   "t1": 4.364,
   "scene": 2,
   "text": "Alle anderen sind weg."
  },
  {
   "t0": 4.644,
   "t1": 6.399,
   "scene": 2,
   "text": "Nur ich und dieser alte Leuchtturm."
  },
  {
   "t0": 6.849,
   "t1": 9.297,
   "scene": 3,
   "text": "Licht ist das Einzige, wovor die Schatten Angst haben."
  },
  {
   "t0": 9.747,
   "t1": 11.339,
   "scene": 4,
   "text": "Mein Vorrat: eine Taschenlampe."
  },
  {
   "t0": 11.619,
   "t1": 12.83,
   "scene": 4,
   "text": "Und eine einzige Batterie."
  },
  {
   "t0": 13.28,
   "t1": 14.429,
   "scene": 5,
   "text": "Die hält genau eine Nacht."
  },
  {
   "t0": 14.879,
   "t1": 16.178,
   "scene": 6,
   "text": "Aber ich muss nicht allein bleiben."
  },
  {
   "t0": 16.628,
   "t1": 19.085,
   "scene": 7,
   "text": "Jeder Follow ist ein neuer Mitbewohner im Leuchtturm."
  },
  {
   "t0": 19.535,
   "t1": 20.367,
   "scene": 8,
   "text": "Die Sonne geht unter."
  },
  {
   "t0": 20.647,
   "t1": 21.65,
   "scene": 8,
   "text": "Und ich höre schon etwas."
  },
  {
   "t0": 22.1,
   "t1": 22.889,
   "scene": 9,
   "text": "Was soll ich tun?"
  },
  {
   "t0": 23.169,
   "t1": 24.85,
   "scene": 9,
   "text": "1: Licht an und durchhalten."
  },
  {
   "t0": 25.13,
   "t1": 27.172,
   "scene": 9,
   "text": "2: Im Supermarkt Batterien suchen."
  },
  {
   "t0": 27.452,
   "t1": 29.277,
   "scene": 9,
   "text": "3: Den großen Scheinwerfer reparieren."
  }
 ],
